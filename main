local function CreateToggleButton(Name, LabelText, LayoutOrder, Callback)
    local ButtonFrame = Instance.new("Frame", ScrollingFrame)
    ButtonFrame.BackgroundColor3 = Color3.fromRGB(255, 255, 255); ButtonFrame.Size = UDim2.new(0, 220, 0, 40); ButtonFrame.LayoutOrder = LayoutOrder
    Instance.new("UICorner", ButtonFrame).CornerRadius = UDim.new(0, 6)
    local gb = Instance.new("UIGradient", ButtonFrame); gb.Color = ColorSequence.new{ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 170, 0)), ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 85, 0))}; gb.Rotation = 90
    local Title_B = Instance.new("TextLabel", ButtonFrame); Title_B.BackgroundTransparency = 1; Title_B.Position = UDim2.new(0.05, 0, 0, 0); Title_B.Size = UDim2.new(0.6, 0, 1, 0); Title_B.Font = Enum.Font.FredokaOne; Title_B.Text = LabelText; Title_B.TextColor3 = Color3.fromRGB(255, 255, 255); Title_B.TextSize = 16; Title_B.TextXAlignment = Enum.TextXAlignment.Left
    local Box = Instance.new("Frame", ButtonFrame); Box.BackgroundColor3 = Color3.fromRGB(255, 255, 255); Box.Position = UDim2.new(0.75, 0, 0.15, 0); Box.Size = UDim2.new(0, 48, 0, 28)
    Instance.new("UICorner", Box).CornerRadius = UDim.new(0, 4)
    local gbox = Instance.new("UIGradient", Box); gbox.Color = ColorSequence.new{ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 170, 0)), ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 85, 0))}; gbox.Rotation = 90
    local StatusText = Instance.new("TextLabel", Box); StatusText.BackgroundTransparency = 1; StatusText.Size = UDim2.new(1, 0, 1, 0); StatusText.Font = Enum.Font.FredokaOne; StatusText.Text = "OFF"; StatusText.TextColor3 = Color3.fromRGB(255, 0, 0); StatusText.TextSize = 14
    local active = false
    Box.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            active = not active
            StatusText.Text = active and "ON" or "OFF"
            StatusText.TextColor3 = active and Color3.fromRGB(0, 255, 0) or Color3.fromRGB(255, 0, 0)
            if Callback then Callback(active) end
        end
    end)
end

-- [[ SYSTEM: GUI PLAYER SELECTOR ]]
local function CreatePlayerDropdown(Title, Order, Mode)
    local DropFrame = Instance.new("Frame", ScrollingFrame)
    DropFrame.BackgroundColor3 = Color3.fromRGB(40, 40, 40); DropFrame.Size = UDim2.new(0, 220, 0, 150); DropFrame.LayoutOrder = Order
    Instance.new("UICorner", DropFrame)
    
    local DropTitle = Instance.new("TextLabel", DropFrame)
    DropTitle.Size = UDim2.new(1, 0, 0, 25); DropTitle.BackgroundTransparency = 1; DropTitle.Font = Enum.Font.FredokaOne; DropTitle.Text = Title; DropTitle.TextColor3 = Color3.fromRGB(255, 170, 0); DropTitle.TextSize = 14
    
    local Scroll = Instance.new("ScrollingFrame", DropFrame)
    Scroll.Position = UDim2.new(0, 5, 0, 25); Scroll.Size = UDim2.new(1, -10, 1, -30); Scroll.BackgroundTransparency = 1; Scroll.CanvasSize = UDim2.new(0,0,0,0); Scroll.ScrollBarThickness = 2
    local List = Instance.new("UIListLayout", Scroll); List.Padding = UDim.new(0, 2)

    local function updateList()
        for _, v in pairs(Scroll:GetChildren()) do if v:IsA("TextButton") then v:Destroy() end end
        for _, p in pairs(Players:GetPlayers()) do
            if p == localPlayer then continue end
            local pBtn = Instance.new("TextButton", Scroll)
            pBtn.Size = UDim2.new(1, -5, 0, 22); pBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 50); pBtn.Font = Enum.Font.FredokaOne; pBtn.Text = p.DisplayName; pBtn.TextColor3 = Color3.new(1,1,1); pBtn.TextSize = 12
            Instance.new("UICorner", pBtn)
            
            local function refreshBtnColor()
                if Mode == "Lock" then
                    pBtn.BackgroundColor3 = (TargetPriorityPlayer == p) and Color3.fromRGB(255, 170, 0) or Color3.fromRGB(50, 50, 50)
                else
                    pBtn.BackgroundColor3 = (WhitelistedPlayers[p.UserId]) and Color3.fromRGB(255, 50, 50) or Color3.fromRGB(50, 50, 50)
                end
            end
            refreshBtnColor()

            pBtn.MouseButton1Click:Connect(function()
                if Mode == "Lock" then
                    if TargetPriorityPlayer == p then TargetPriorityPlayer = nil else TargetPriorityPlayer = p end
                else
                    if WhitelistedPlayers[p.UserId] then WhitelistedPlayers[p.UserId] = nil else WhitelistedPlayers[p.UserId] = true end
                end
                updateList() -- Refresh UI
            end)
        end
        Scroll.CanvasSize = UDim2.new(0, 0, 0, List.AbsoluteContentSize.Y)
    end
    updateList()
    Players.PlayerAdded:Connect(updateList); Players.PlayerRemoving:Connect(updateList)
end

