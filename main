-- ระบบทำงาน Camlock & Target Tracking
RunService.RenderStepped:Connect(function()
    if (Camlock_Enabled or SilentAim_Enabled) then
        CurrentTarget = getTarget()
        
        if CurrentTarget and CurrentTarget.Parent and CurrentTarget.Parent:FindFirstChild("Humanoid") and CurrentTarget.Parent.Humanoid.Health > 0 then
            if Camlock_Enabled and IsHoldingRightClick then
                Camera.CFrame = CFrame.new(Camera.CFrame.Position, CurrentTarget.Position)
            end
            
            local targetPlayer = Players:GetPlayerFromCharacter(CurrentTarget.Parent)
            if targetPlayer then
                NameDisplay.Text = (TargetPriorityPlayer == targetPlayer and "⭐ " or "") .. targetPlayer.DisplayName 
                InfoMain.Visible = true
                NamePlayers.Text = "Name | " .. targetPlayer.DisplayName
                HealthPlayers.Text = "Health | " .. math.floor(CurrentTarget.Parent.Humanoid.Health) .. "/" .. CurrentTarget.Parent.Humanoid.MaxHealth
                local hpPercent = CurrentTarget.Parent.Humanoid.Health / CurrentTarget.Parent.Humanoid.MaxHealth
                Healthgreen.Size = UDim2.new(hpPercent, 0, 0, 8)
                ImageProfile.Image = Players:GetUserThumbnailAsync(targetPlayer.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size420x420)
            end
        else
            CurrentTarget = nil
            InfoMain.Visible = false
            NameDisplay.Text = "NONE"
        end
    else
        CurrentTarget = nil
        InfoMain.Visible = false
        NameDisplay.Text = "NONE"
    end
end)

local function getTeamColor(player)
    if player.Team and (player.Team.Name == "Marines" or player.Team.Name == "Navy") then
        return Color3.fromRGB(0, 162, 255)
    elseif player.Team and (player.Team.Name == "Pirates") then
        return Color3.fromRGB(255, 30, 30)
    end
    return Color3.fromRGB(255, 255, 255)
end

local function createESP(player)
    if player == localPlayer then return end
    local function applyESP(character)
        local old = UiLib:FindFirstChild("ESP_" .. player.Name)
        if old then old:Destroy() end
        local head = character:WaitForChild("Head", 10)
        local hum = character:WaitForChild("Humanoid", 10)
        if not head or not hum then return end
        local billboard = Instance.new("BillboardGui")
        billboard.Name = "ESP_" .. player.Name; billboard.AlwaysOnTop = true; billboard.Size = UDim2.new(0, 200, 0, 70); billboard.Adornee = head; billboard.ExtentsOffset = Vector3.new(0, 3, 0); billboard.Parent = UiLib
        local infoLabel = Instance.new("TextLabel")
        infoLabel.Parent = billboard; infoLabel.BackgroundTransparency = 1; infoLabel.Size = UDim2.new(1, 0, 1, 0); infoLabel.Font = Enum.Font.FredokaOne; infoLabel.TextColor3 = getTeamColor(player); infoLabel.TextSize = 14; infoLabel.TextStrokeTransparency = 0; infoLabel.TextYAlignment = Enum.TextYAlignment.Top
        local conn; conn = RunService.RenderStepped:Connect(function()
            if not ESP_Enabled then billboard.Enabled = false; return end
            if not player.Parent or not character.Parent or hum.Health <= 0 then billboard:Destroy(); conn:Disconnect(); return end
            billboard.Enabled = true
            local root = character:FindFirstChild("HumanoidRootPart")
            local dist = 0
            if root and localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart") then
                dist = math.floor((localPlayer.Character.HumanoidRootPart.Position - root.Position).Magnitude)
            end
            local bounty = "0"
            local lstats = player:FindFirstChild("leaderstats")
            if lstats then
                local bVal = lstats:FindFirstChild("Bounty") or lstats:FindFirstChild("Bounty/Honor")
                if bVal then bounty = tostring(bVal.Value) end
            end
            infoLabel.Text = string.format("[%s]\n%s\nHP: %d | Dist: %dm\nBounty: %s", player.Team and player.Team.Name or "No Team", player.DisplayName, math.floor(hum.Health), dist, bounty)
            infoLabel.TextColor3 = getTeamColor(player)
        end)
    end
    player.CharacterAdded:Connect(applyESP)
    if player.Character then task.defer(applyESP, player.Character) end
end

local function ToggleCamlock()
    Camlock_Enabled = not Camlock_Enabled
    AimBtn.TextColor3 = (Camlock_Enabled or SilentAim_Enabled) and Color3.fromRGB(0, 255, 0) or Color3.fromRGB(255, 0, 0)
end

AimBtn.MouseButton1Click:Connect(ToggleCamlock)
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if not gameProcessed then
        if input.KeyCode == Enum.KeyCode.G then ToggleCamlock()
        elseif input.UserInputType == Enum.UserInputType.MouseButton2 then IsHoldingRightClick = true end
    end
end)
UserInputService.InputEnded:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton2 then IsHoldingRightClick = false end end)

